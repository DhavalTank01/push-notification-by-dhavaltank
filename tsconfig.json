{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationDir": "./dist",
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["react", "node"],
    "typeRoots": [
      "node_modules/@types",
      "src"
    ]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
